{
  "name": "novel-tracker-epub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package:win": "npm run build && node scripts/package-windows.mjs",
    "lint": "eslint src",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@primeuix/themes": "^1.2.3",
    "cheerio": "^1.0.0",
    "csv-parse": "^7.0.3",
    "fast-xml-parser": "^5.3.0",
    "jszip": "^3.10.1",
    "pinia": "^3.0.1",
    "playwright": "^1.65.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.3.5",
    "sharp": "^0.35.5",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^3.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.2.2",
    "vue-tsc": "^3.3.14"
  },
  "build": {
    "appId": "com.brightfyre.noveltracker",
    "productName": "NovelTracker",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": ".playwright-browsers",
        "to": "playwright-browsers"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
